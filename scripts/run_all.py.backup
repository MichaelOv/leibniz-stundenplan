#!/usr/bin/env python3
import json, sys, hashlib, subprocess
from pathlib import Path
from datetime import datetime, timezone, timedelta

BASE = Path(__file__).resolve().parent.parent
DATA = BASE / "data"
PYTHON = BASE / "venv/bin/python"

DAYS_DE = {0:"Montag",1:"Dienstag",2:"Mittwoch",3:"Donnerstag",4:"Freitag"}

def get_target_date():
    now = datetime.now(timezone.utc) + timedelta(hours=2)
    if now.weekday() > 4:
        candidate = now.date()
    else:
        candidate = now.date()
    while candidate.weekday() > 4:
        candidate += timedelta(days=1)
    return candidate.isoformat()

def send_ntfy(title, msg, priority=4):
    import requests
    try:
        r = requests.post("https://ntfy.sh/6c-vertretung", 
                         json={"title": title, "message": msg, "priority": priority})
        return r.status_code == 200
    except:
        return False

def run(script, *args):
    result = subprocess.run([PYTHON, str(BASE / "scripts" / script)] + list(args),
                           capture_output=True, text=True)
    print(result.stdout.strip())
    if result.stderr.strip():
        print("STDERR:", result.stderr.strip())
    return result

if __name__ == "__main__":
    target = sys.argv[1] if len(sys.argv) > 1 else get_target_date()
