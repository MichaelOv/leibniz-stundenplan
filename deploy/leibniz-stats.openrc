#!/sbin/openrc-run

name="leibniz-stats"
description="Ausfallstatistik 7c (Leibniz Stundenplan)"

: ${LEIBNIZ_DIR:=/root/leibniz-stundenplan}

command="${LEIBNIZ_DIR}/venv/bin/python"
command_args="${LEIBNIZ_DIR}/stats_server.py"
command_background=false
directory="${LEIBNIZ_DIR}"
supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/leibniz-stats.log"
error_log="/var/log/leibniz-stats.log"
respawn_delay=5
respawn_max=0

depend() {
    need net
    after firewall
}
